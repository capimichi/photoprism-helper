APP_NAME=photoprism-helper
DEBUG=false

# MariaDB / MySQL Database Connection
DATABASE_URL=mysql+pymysql://photoprismhelper:photoprismhelper@localhost:3306/photoprismhelper

# MariaDB Docker Compose Settings
MARIADB_DATABASE=photoprismhelper
MARIADB_USER=photoprismhelper
MARIADB_PASSWORD=photoprismhelper
MARIADB_ROOT_PASSWORD=root

# PhotoPrism Connection
# Provide either username/password (session auth) OR an API token
PHOTOPRISM_BASE_URL=http://localhost:2342
PHOTOPRISM_USERNAME=admin
PHOTOPRISM_PASSWORD=insecure
PHOTOPRISM_API_TOKEN=
PHOTOPRISM_VERIFY_SSL=true
PHOTOPRISM_TIMEOUT_SECONDS=60

# Local or mounted originals path (used for direct video inspection/FFmpeg optimization)
PHOTOPRISM_ORIGINALS_PATH=/photoprism/originals
